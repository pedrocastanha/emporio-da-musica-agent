# OpenAI is the default provider (see README "Model & provider").
OPENAI_API_KEY=sk-...

# Chat model used by the agent and embedding model used for policy retrieval.
EMPORIO_CHAT_MODEL=gpt-4.1-mini
EMPORIO_EMBEDDING_MODEL=text-embedding-3-small
EMPORIO_TEMPERATURE=0.2

# SQLite file for conversation history and handoff tickets (default: var/emporio.sqlite).
# EMPORIO_DB_PATH=var/emporio.sqlite

# Optional: freeze "now" (store local time, America/Campo_Grande) for reproducible demos.
# EMPORIO_NOW=2026-11-03T10:30:00
